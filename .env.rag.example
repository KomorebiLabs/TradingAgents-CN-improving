# RAG (Retrieval Augmented Generation) Configuration

# ================================================================================
# RAG System Configuration
# ================================================================================

# Enable or disable RAG system globally
# Options: true, false
# Default: false
TRADINGAGENTS_RAG_ENABLED=false

# ================================================================================
# Embedding Model Configuration
# ================================================================================

# Embedding model type
# Options: mini_lm, bge, openai
# Default: mini_lm
TRADINGAGENTS_EMBEDDING_MODEL=mini_lm

# Embedding model name (for HuggingFace models)
# Default: sentence-transformers/all-MiniLM-L6-v2
TRADINGAGENTS_EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Embedding dimension (auto-detected if not specified)
# Options: 384 (MiniLM), 768 (BGE-base), 1024 (BGE-large)
# Default: auto
# TRADINGAGENTS_EMBEDDING_DIMENSION=384

# ================================================================================
# Vector Store Configuration
# ================================================================================

# Vector store type
# Options: memory, chromadb, faiss
# Default: memory
TRADINGAGENTS_VECTOR_STORE_TYPE=memory

# Persist directory for ChromaDB/FAISS (optional)
# Default: ./rag_data
# TRADINGAGENTS_VECTOR_STORE_PATH=./rag_data

# Collection name for vector store
# Default: tradingagents_documents
# TRADINGAGENTS_COLLECTION_NAME=tradingagents_documents

# ================================================================================
# Retriever Configuration
# ================================================================================

# Hybrid search weights (BM25 vs Vector)
# Format: bm25_weight,vector_weight
# Default: 0.3,0.7
# TRADINGAGENTS_RETRIEVAL_WEIGHTS=0.3,0.7

# Initial retrieval count (before reranking)
# Default: 50
# TRADINGAGENTS_INITIAL_TOP_K=50

# Final retrieval count (after reranking)
# Default: 10
# TRADINGAGENTS_FINAL_TOP_K=10

# ================================================================================
# Reranker Configuration
# ================================================================================

# Enable/disable cross-encoder reranker
# Options: true, false
# Default: true
TRADINGAGENTS_RERANKER_ENABLED=true

# Cross-encoder model name
# Default: cross-encoder/ms-marco-MiniLM-L-6-v2
# TRADINGAGENTS_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ================================================================================
# Fallback Configuration
# ================================================================================

# Fall back to raw data when RAG fails
# Options: true, false
# Default: true
TRADINGAGENTS_RAG_FALLBACK_TO_RAW=true

# Cache RAG results
# Options: true, false
# Default: true
TRADINGAGENTS_CACHE_RESULTS=true
