# ================================================================================
# TradingAgents Configuration
# ================================================================================
# Copy this file to .env and fill in your API keys.
# At least one LLM provider is required to run the project.

# ================================================================================
# LLM Provider API Keys
# ================================================================================

# OpenAI (GPT series)
OPENAI_API_KEY=sk-your-openai-key-here

# Google (Gemini series)
# GOOGLE_API_KEY=

# Anthropic (Claude series)
# ANTHROPIC_API_KEY=

# DeepSeek
# DEEPSEEK_API_KEY=

# Agnes AI (OpenAI-compatible gateway)
# AGNES_API_KEY=

# Qwen / Alibaba Cloud (阿里云通义千问)
# DASHSCOPE_API_KEY=

# GLM / Zhipu (智谱 GLM)
# ZHIPU_API_KEY=

# xAI (Grok series)
# XAI_API_KEY=

# OpenRouter (100+ models, unified access)
# OPENROUTER_API_KEY=

# Alpha Vantage (stock data API)
# ALPHA_VANTAGE_API_KEY=

# Tushare Pro (optional independent financial statements; account permissions/points apply)
# TUSHARE_TOKEN=
# TUSHARE_ENABLED=false

# ================================================================================
# Network Proxy (optional)
# ================================================================================
# Uncomment and set if you need a proxy to access LLM APIs.
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# ================================================================================
# Advanced Options
# ================================================================================
# See .env.enterprise.example for Azure OpenAI configuration.
# See .env.rag.example for RAG system configuration.
